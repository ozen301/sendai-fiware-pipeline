# Sendai FIWARE pipeline configuration template.
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# See docs/configuration.md for the full variable reference: defaults,
# accepted values, and what each variable does.
#
# Required variables (FIWARE credentials, MySQL access) are uncommented
# below with placeholder values; you must fill them in for any run,
# including dry-run, because the runners build their auth/DB settings
# unconditionally. Other variables are left commented so the runner
# uses the defaults from docs/configuration.md.

# --- FIWARE platform ---
FIWARE_BASE_URL=https://<FQDN>
FIWARE_CONSUMER_KEY=<consumer_key>
FIWARE_CONSUMER_SECRET=<consumer_secret>
FIWARE_SERVICE=
FIWARE_SERVICE_PATH=/
# FIWARE_TOKEN_URL=
# FIWARE_TOKEN_SCOPE=
# FIWARE_TOKEN_CACHE_PATH=
# FIWARE_TOKEN_REFRESH_MARGIN_SECONDS=
# FIWARE_TOKEN_TIMEOUT_SECONDS=
# FIWARE_TIMEOUT_SECONDS=
# FIWARE_VERIFY_TLS=

# --- STH-Comet subscriptions (only scripts/create_sth_subscriptions.py) ---
# COMET_NOTIFY_URL=<internal-comet-notify-url>
# STH_SUBSCRIPTION_EXPIRES=
# STH_SUBSCRIPTION_SKIP_INITIAL=
# STH_SUBSCRIPTION_THROTTLING_SECONDS=

# --- MySQL source ---
MYSQL_HOST=<host>
MYSQL_USER=<read-only user>
MYSQL_PASSWORD=<password>
MYSQL_DATABASE=<database>
# MYSQL_PORT=
# MYSQL_CONNECT_TIMEOUT=
# MYSQL_READ_TIMEOUT=
# MYSQL_CHARSET=

# --- Sensor metadata ---
# SENSOR_METADATA_PATH=
# SENSOR_METADATA_STABLE_PATH=
# SENSOR_METADATA_STAGED_PATH=

# --- Filters and rollout gates ---
# TARGET_FLOW_BATCHES=
# TARGET_DIRECTION_BATCHES=
# FLOW_SEND_MODE=
# DIRECTION_SEND_MODE=
# IGNORED_PLACE_PREFIXES=
# SOURCE_MAX_IMPUTATION_TIER=

# --- Window timing and retry horizons ---
# SOURCE_STABILITY_DELAY_HOURS=
# REPROCESS_HOURS_PER3600=
# REPROCESS_HOURS_PER300=
# MAX_LOOKBACK_HOURS_PER3600=
# MAX_LOOKBACK_HOURS_PER300=

# --- Logging ---
# LOG_LEVEL=
# LOG_FORMAT=
# LOG_PAYLOAD_MODE=
# LOG_PAYLOAD_MAX_BYTES=
# LOG_RESPONSE_MAX_BYTES=
# LOG_DIR=
